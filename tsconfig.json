{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@finview/crypto": ["./packages/crypto/src/index.ts"],
      "@finview/crypto/*": ["./packages/crypto/src/*"]
    }
  },
  "include": [
    "packages/**/*",
    "apps/**/*",
    "tests/**/*"
  ]
}
